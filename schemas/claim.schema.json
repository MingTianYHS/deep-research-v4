{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "description": "从报告中抽取的一条原子论点。claim_id = sha256(section_id + sentence_text)[:16]。",
  "type": "object",
  "required": ["claim_id", "section_id", "text", "claim_type", "materiality", "support_status"],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "sha256(section_id + normalized_text)[:16]"
    },
    "section_id": {
      "type": "string",
      "description": "章节标识（如 executive_summary、finding_1、synthesis）"
    },
    "text": {
      "type": "string",
      "description": "原子论点句子"
    },
    "claim_type": {
      "type": "string",
      "enum": ["factual", "synthesis", "recommendation", "speculation"],
      "description": "只有 factual 论点在缺少支撑时硬失败"
    },
    "materiality": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "default": "B",
      "description": "材料性分级：A 硬事实、B 背景、C 分析、D 推测"
    },
    "cited_source_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
      "default": [],
      "description": "该论点引用的稳定 source_id"
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
      "default": [],
      "description": "支撑该论点的 evidence_id"
    },
    "support_status": {
      "type": "string",
      "enum": ["unverified", "supported", "partial", "unsupported", "needs_review"],
      "description": "由 verify_claim_support.py 写入"
    },
    "_support_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "verify_claim_support.py 计算的重合分（内部字段）"
    },
    "_support_notes": {
      "type": "string",
      "description": "verify_claim_support.py 生成的复核说明（内部字段）"
    },
    "_citation_numbers": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "抽取阶段临时保存的正文引用编号（内部字段）"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time",
      "description": "论点抽取时间（ISO 8601）"
    }
  },
  "additionalProperties": false
}
