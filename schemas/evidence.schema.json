{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "description": "从来源中采集的一条证据。evidence_id = sha256(source_id + normalized_quote + locator)[:16]。",
  "type": "object",
  "required": ["evidence_id", "source_id", "quote", "evidence_type", "captured_at"],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "sha256(source_id + normalized_quote + locator)[:16]"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "对应 来源.jsonl 中的来源"
    },
    "retrieval_query": {
      "type": ["string", "null"],
      "description": "得到该证据的检索词或提示",
      "default": null
    },
    "query": {
      "type": ["string", "null"],
      "description": "触发该证据的检索式或任务（可选，兼容旧字段）",
      "default": null
    },
    "locator": {
      "type": ["string", "null"],
      "description": "来源内的位置：页码、章节标题、URL 片段或时间戳",
      "default": null
    },
    "quote": {
      "type": "string",
      "description": "从来源中提取的原文或近原文"
    },
    "evidence_type": {
      "type": "string",
      "enum": ["direct_quote", "paraphrase", "data_point", "methodology", "official_statement"],
      "description": "证据采集方式"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "证据采集时间（ISO 8601）"
    }
  },
  "additionalProperties": false
}
