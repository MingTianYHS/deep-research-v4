{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "description": "单次研究的运行清单（运行清单.json），在 init 时创建，可随研究过程更新。",
  "type": "object",
  "required": ["version", "query", "query_type", "rigor", "mode", "budget", "language", "started_at", "report_dir", "artifact_paths"],
  "properties": {
    "version": {
      "type": "string",
      "const": "4.0.0"
    },
    "query": {
      "type": "string",
      "description": "原始研究问题"
    },
    "query_type": {
      "type": "string",
      "enum": ["direct", "depth", "breadth"],
      "description": "查询形态：直接型、深度优先、广度优先"
    },
    "rigor": {
      "type": "string",
      "enum": ["standard", "deep"],
      "description": "验证强度"
    },
    "mode": {
      "type": "string",
      "enum": ["direct", "standard", "deep"],
      "description": "研究路径：直查 / 标准研究 / 深研"
    },
    "budget": {
      "type": "string",
      "enum": ["normal", "extended"],
      "description": "检索预算；extended 对应原 ultradeep 的加大预算"
    },
    "language": {
      "type": "string",
      "enum": ["zh", "en"],
      "default": "zh",
      "description": "报告语言"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "研究开始时间（ISO 8601）"
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null,
      "description": "研究收尾时间（由 finalize-run 写入）"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "text", "materiality", "status"],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^asm_[0-9a-f]{8}$"
          },
          "text": { "type": "string" },
          "materiality": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "status": {
            "type": "string",
            "enum": ["implicit", "user_confirmed", "evidence_validated"]
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "provider_config": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "description": "主要检索工具（DSH 为 web_search）"
        },
        "scholarly": {
          "type": ["string", "null"],
          "description": "学术 API 提供方（可选，如 openalex、semantic_scholar）"
        }
      },
      "default": { "primary": "web_search", "scholarly": null }
    },
    "report_dir": {
      "type": "string",
      "description": "报告目录绝对路径"
    },
    "artifact_paths": {
      "type": "object",
      "required": ["sources", "evidence", "claims", "report"],
      "properties": {
        "plan": { "type": "string", "default": "研究计划.md" },
        "sources": { "type": "string", "default": "来源.jsonl" },
        "evidence": { "type": "string", "default": "证据.jsonl" },
        "claims": { "type": "string", "default": "论点.jsonl" },
        "report": { "type": "string", "default": "研究报告.md" },
        "open_source_solutions": { "type": "string", "default": "开源方案.jsonl" }
      },
      "additionalProperties": false
    },
    "continuation": {
      "type": ["object", "null"],
      "description": "续写上一轮研究时填充",
      "properties": {
        "previous_run_manifest": { "type": "string" },
        "resumed_at": { "type": "string", "format": "date-time" },
        "sections_completed": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "default": null
    }
  },
  "additionalProperties": false
}
